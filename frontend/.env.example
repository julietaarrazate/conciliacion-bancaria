# Variables de entorno del frontend (Vite)
# Agregar en Vercel > Settings > Environment Variables (sin comillas)

# URL del backend en Render (produccion)
VITE_API_URL=https://conciliacion-api.onrender.com

# Desarrollo local:  VITE_API_URL=http://localhost:8000
# Desarrollo LAN:    VITE_API_URL=http://192.168.1.8:8000
