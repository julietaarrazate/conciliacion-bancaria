# Copiar a .env y completar con valores reales
# NUNCA commitear el .env real

# Base de datos
POSTGRES_USER=conciliacion
POSTGRES_PASSWORD=cambiar_esto
POSTGRES_DB=conciliacion_db

# Backend
DATABASE_URL=postgresql+asyncpg://conciliacion:cambiar_esto@localhost/conciliacion_db
SECRET_KEY=generar-con-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Frontend
VITE_API_URL=http://localhost:8000

# Mobile (Expo)
EXPO_PUBLIC_API_URL=http://localhost:8000
